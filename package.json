{
  "name": "inflow-fde",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter server --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "seed": "pnpm --filter server seed",
    "fde": "pnpm --silent --filter server fde",
    "build": "pnpm --filter web build",
    "build:demo": "pnpm --filter web build:demo",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @inflow/core test"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "InFlow FDE：企业 AI 转型操盘台（主 Agent → 部门 Agent → 数字员工，AI 出建议、人拍板、成本逐笔记账）",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0"
}
